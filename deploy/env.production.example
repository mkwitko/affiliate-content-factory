# Copy to /opt/money-maker-mcp/.env on the server and fill every value from the
# deployment secret store. Never commit the filled file.
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
POST_FOR_ME_WEBHOOK_SECRET=
PUBLIC_API_URL=https://api.example.com
MCP_RESOURCE_URL=https://api.example.com/mcp

AUTH_ISSUER_URL=https://your-tenant.us.auth0.com/
AUTH_CLIENT_ID=replace-with-auth0-client-id
AUTH_CLIENT_SECRET=replace-with-oidc-client-secret
AUTH_AUDIENCE=https://api.example.com/mcp
AUTH_REDIRECT_URI=https://api.example.com/v1/auth/callback
WEB_APP_URL=https://app.example.com
SESSION_SECRET=replace-with-a-new-32-byte-base64url-value

SECRET_STORE_MASTER_KEY=replace-with-a-new-32-byte-base64url-value

# Optional. Jev records advisory decisions only; active routing is unavailable until calibrated.
JEV_ENABLED=false
JEV_MODE=shadow
# TYPESAFE_API_KEY is supplied by the staging GitHub environment secret only when Jev is enabled.

# Optional until R2 is configured. Set all four together when enabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_TTL=900

# Optional. Workers AI scene generation; set all three together.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY=money-maker
# Optional. YouTube source search/inspect.
YOUTUBE_DATA_API_KEY=
# TTS_URL, REEL_VOICE_DEFAULT and REEL_MUSIC_DIR are set by deploy/docker-compose.yml.
