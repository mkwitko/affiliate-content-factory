DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_maker
# Use a direct, non-pooled PostgreSQL URL for Prisma migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/money_maker
# The integration suite uses this URL when a PostgreSQL test database is available.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_maker_test
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
POST_FOR_ME_WEBHOOK_SECRET=

# Public HTTPS base URL used when registering Post For Me webhooks.
PUBLIC_API_URL=https://api.example.com
# Auth0 tenant issuer, including the trailing slash.
AUTH_ISSUER_URL=https://your-tenant.us.auth0.com/
# Auth0 Regular Web Application client credentials.
AUTH_CLIENT_ID=replace-with-auth0-client-id
AUTH_CLIENT_SECRET=replace-with-oidc-client-secret
# Auth0 API Identifier. Use the same value as MCP_RESOURCE_URL when possible.
AUTH_AUDIENCE=https://api.example.com/mcp
AUTH_REDIRECT_URI=http://localhost:3000/v1/auth/callback
WEB_APP_URL=http://localhost:5173
# OAuth Protected Resource identifier advertised to ChatGPT and other MCP clients.
MCP_RESOURCE_URL=https://api.example.com/mcp
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-new-32-byte-base64url-value

# Required by the API to encrypt workspace-owned provider secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRET_STORE_MASTER_KEY=replace-with-a-new-32-byte-base64url-value

# Global Cloudflare R2 storage configuration. Keep real values only in .env or a secret manager.
# R2 access keys are separate from the Cloudflare API token used by the MCP server.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=replace-with-r2-bucket-name
R2_SIGNED_URL_TTL=900

# Cloudflare Workers AI + AI Gateway (scene generation spike/pipeline).
# Token scope: Workers AI - Read, AI Gateway - Read, AI Gateway - Edit.
# Create the gateway once in the dashboard (AI > AI Gateway) and paste its name.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY=money-maker
# YouTube Data API v3 key (read-only source search/inspect). Empty disables those tools.
YOUTUBE_DATA_API_KEY=
# Public R2 custom domain used to test Cloudflare Images `segment=foreground` by URL (optional).
CLOUDFLARE_IMAGES_ORIGIN=

# Kokoro-FastAPI TTS for Reel voice and long-form narration. Empty disables voice and
# render_long_form. Local: docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:v0.9.0
# Production sets TTS_URL, REEL_VOICE_DEFAULT and REEL_MUSIC_DIR in deploy/docker-compose.yml.
TTS_URL=http://localhost:8880
REEL_VOICE_DEFAULT=pf_dora
# Stage artifact cache: stores Kokoro clips as workspace assets keyed by text, voice, language and
# TTS_MODEL_VERSION so retries and repeated phrases skip synthesis. STAGE_CACHE=off disables it.
# Bump TTS_MODEL_VERSION when the Kokoro image changes so old clips miss.
STAGE_CACHE=
TTS_MODEL_VERSION=kokoro-v1
# Folder of licensed background tracks for Reels; empty or absent renders silent Reels.
REEL_MUSIC_DIR=
# Experimental AI background removal for non-white product photos (worker only). Empty keeps
# today's framed photo. Argv with {input} and {output}, no shell; rembg needs an explicit model
# (its default, BRIA RMBG, is not licensed for commercial use). Example:
# SEGMENTER_CMD=rembg i -m isnet-general-use -om {input} {output}
SEGMENTER_CMD=

# Worker process (apps/worker). Profiles: full (default), render_only or local_ai (no HTTP, no
# auth component); WORKER_JOBS narrows the profile's job list; the lease and the heavy-job deadline
# must satisfy RENDER_JOB_TIMEOUT_MS + 60000 <= WORKER_LEASE_MS. See docs/operations/configuration.md.
WORKER_PROFILE=full
WORKER_JOBS=
WORKER_ID=
WORKER_LEASE_MS=900000
RENDER_JOB_TIMEOUT_MS=720000
# ffmpeg threads and sharp concurrency for renders; empty keeps the defaults (also read by the
# render-bench and style-frames commands).
RENDER_THREADS=
# 1 draws the static vignette layer once per render instead of in every frame (v2 slice 17;
# pixel-identical, measured in docs/audits/2026-09-30-hardware-benchmarks.md B2). Empty = off.
STICKMAN_LAYER_CACHE=
# Local scene director (llama-server on loopback only; home machines, never the A1). Empty
# disables it. Used by director-bench and by the direct_scenes job of a local_ai worker.
SCENE_DIRECTOR_URL=
SCENE_DIRECTOR_MODEL=
# Optional benchmark timeout (10 s to 1 h); empty uses the adapter's 5 minute default.
SCENE_DIRECTOR_TIMEOUT_MS=
# Optional sampling temperature, 0 to 1; empty means 0 (greedy, reproducible benchmarks).
SCENE_DIRECTOR_TEMPERATURE=
# Optional JSON array for a fair, same-fixture multi-model director-bench run. Example:
# [{"baseUrl":"http://127.0.0.1:18080","model":"qwen3.8-9b","runtime":"llama.cpp","quantization":"Q4_K_M"}]
DIRECTOR_BENCH_CANDIDATES=
# VLM key-frame review (v2 slice 29): llama-server --mmproj on loopback. Empty disables review_frames.
FRAME_REVIEWER_URL=
FRAME_REVIEWER_MODEL=
# API side: registers the request_scene_direction MCP tool. Leave empty until B3 passes.
SCENE_DIRECTION_ENABLED=
# Legacy SceneGenerator CLI fallback for generate_plates. Leave both empty when using
# IMAGE_GEN_URL/stable-diffusion.cpp. They must be set together; command is argv, not a shell line.
SCENE_GENERATOR_CMD=
SCENE_GENERATOR_MODEL=

# Hosted Jev decisions: disabled; shadow records advice but does not route production.
JEV_ENABLED=false
JEV_MODE=shadow
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=

# The full worker runs the autonomy cycle every 15 minutes (default on); set false to stop it.
AUTONOMY_ENABLED=true

# Native stable-diffusion.cpp service on the home machine. All new media paths stay off
# until the corresponding phase is enabled and server policy admits its expected model.
# local_only | local_first | cloud_allowed (default). local_only never calls Workers AI or Agnes.
GENERATION_POLICY=cloud_allowed
LOCAL_AI_ENABLED=false
IMAGE_GEN_URL=
IMAGE_GEN_MODEL=local:z-image-turbo
IMAGE_EDIT_URL=
IMAGE_EDIT_MODEL=local:flux-2-klein-4b
# "on": auto-package scenes follow the shot per slide template (hands close-up, product hero
# without people); unset keeps the copy-as-moment prompt. Opt-in until the owner judges a package.
OFFER_SCENE_DIRECTION=
# "on" (with direction on): the product-only slots of a count-critical product draw only a
# backdrop and get the listing photo's cut-out composited on it (Phase 3). Opt-in until the arena
# run qualifies it.
OFFER_SCENE_COMPOSITE=
LOCAL_VIDEO_ENABLED=false
VIDEO_GEN_URL=
VIDEO_GEN_MODEL=local:wan2.2-ti2v-5b
LOCAL_AI_REQUEST_TIMEOUT_MS=300000
LOCAL_AI_MAX_IMAGE_BYTES=10000000
LOCAL_AI_MAX_VIDEO_BYTES=50000000
LOCAL_AI_MAX_VIDEO_FRAMES=33
LOCAL_AI_MAX_RETRIES=1

# Home worker client (ADR 0012): `pnpm --filter @money-maker/worker home-worker`. The machine
# holds only these two values plus its local model settings above, never DATABASE_URL or R2.
# The token comes from the create_home_worker_token MCP tool (shown once). https required.
# Keep it in ~/.config/money-maker/home-worker.env (chmod 600), never on a command line.
HOME_WORKER_API_URL=
MONEY_MAKER_HOME_TOKEN=
HOME_WORKER_POLL_MS=30000

# local_ai profile (desktop / M1 only; v2 slice 25). Development against a local database only:
# the worker refuses a non-loopback DATABASE_URL. Production uses the home worker client (ADR 0012).
# LOCAL_MODELS_DIR is an absolute path holding models.json; WORKER_MACHINE_KIND is one of
# linux_cpu | desktop_amd | apple_m1 | cloud_arm. The lease replaces WORKER_LEASE_MS.
LOCAL_MODELS_DIR=
WORKER_MACHINE_KIND=
LOCAL_AI_LEASE_MS=1800000
LOCAL_AI_JOB_TIMEOUT_MS=1500000

# Post For Me and Mercado Livre credentials are workspace-scoped and must be configured through
# the authenticated API/MCP flows, never as global environment variables.

# Generated scene clips (ai_clips, trial). Free key from platform.agnes-ai.com; never commit it.
# AGNES_MODEL: agnes-video-2.5-flash (default) or agnes-video-v2.0 (retired, still served).
AGNES_API_KEY=
AGNES_MODEL=
