model ContentItem {
  id                    String              @id
  workspaceId           String              @map("workspace_id") @db.Uuid
  nicheId               String              @map("niche_id")
  sourceContentItemId   String?             @map("source_content_item_id")
  offerId               String?             @map("offer_id")
  offerSnapshotId       String?             @map("offer_snapshot_id")
  title                 String
  sourceFactKeys        String[]            @map("source_fact_keys")
  sourcePictureAssetIds String[]            @default([]) @map("source_picture_asset_ids")
  creativeSlides        Json?               @map("creative_slides")
  creativeOpinion       String              @map("creative_opinion")
  state                 ContentItemState    @default(DRAFT)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "content_items_workspace_id_fkey")
  niche                 Niche               @relation(fields: [nicheId], references: [id], onDelete: Restrict, map: "content_items_niche_id_fkey")
  offer                 Offer?              @relation(fields: [offerId], references: [id], onDelete: Restrict, map: "content_items_offer_id_fkey")
  offerSnapshot         CommercialSnapshot? @relation("ContentItemSnapshot", fields: [offerSnapshotId], references: [id], onDelete: Restrict, map: "content_items_offer_snapshot_id_fkey")
