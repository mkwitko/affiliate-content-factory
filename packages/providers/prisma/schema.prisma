  maxCostMinorPerPeriod    Int?                  @map("max_cost_minor_per_period")
  periodHours              Int?                  @map("period_hours")
  allowLists               Json?                 @map("allow_lists")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  workspace                Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "publication_policies_workspace_id_fkey")

  @@map("publication_policies")
}

model PublicationAttempt {
  id                 String             @id
  workspaceId        String             @map("workspace_id") @db.Uuid
  contentVariantId   String             @map("content_variant_id")
  channelId          String             @map("channel_id")
  connectionId       String             @map("connection_id") @db.Uuid
  idempotencyKey     String             @map("idempotency_key")
  requestFingerprint String             @map("request_fingerprint")
  status             PublicationStatus  @default(QUEUED)
  externalId         String?            @map("external_id")
  attemptCount       Int                @default(0) @map("attempt_count")
  correlationId      String             @map("correlation_id")
  terminalReason     String?            @map("terminal_reason")
  scheduledAt        DateTime?          @map("scheduled_at")
  // Set when the provider confirms the post; "newest post" orders by it.
  publishedAt        DateTime?          @map("published_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "publication_attempts_workspace_id_fkey")
  contentVariant     ContentVariant     @relation(fields: [contentVariantId], references: [id], onDelete: Restrict, map: "publication_attempts_content_variant_id_fkey")
  channel            Channel            @relation(fields: [channelId], references: [id], onDelete: Restrict, map: "publication_attempts_channel_id_fkey")
  connection         ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict, map: "publication_attempts_connection_id_fkey")

  @@unique([workspaceId, idempotencyKey], map: "publication_attempts_workspace_id_idempotency_key")
  @@index([workspaceId, status], map: "publication_attempts_workspace_status_idx")
  @@map("publication_attempts")
}

model WebhookInbox {
