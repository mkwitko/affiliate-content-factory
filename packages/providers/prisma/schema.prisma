  targetId    String?   @map("target_id")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "audit_events_workspace_id_fkey")
