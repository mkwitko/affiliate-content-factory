  @@id([workspaceId, userId], map: "memberships_pkey")
  @@index([userId, status], map: "memberships_user_id_status_idx")
  @@map("memberships")
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  email        String
  role         MembershipRole
  tokenHash    String           @unique(map: "invitations_token_hash_key") @map("token_hash")
