  leaseExpiresAt DateTime? @map("lease_expires_at")
  terminalReason String?   @map("terminal_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "jobs_workspace_id_fkey")

  @@unique([workspaceId, idempotencyKey], map: "jobs_workspace_id_idempotency_key")
  @@index([status, availableAt, createdAt], map: "jobs_claim_idx")
