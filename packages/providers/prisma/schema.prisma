  @@index([workspaceId, occurredAt], map: "click_events_workspace_occurred_idx")
  @@index([workspaceId, contentVariantId], map: "click_events_workspace_variant_idx")
  @@index([workspaceId, publicationAttemptId], map: "click_events_workspace_publication_idx")
