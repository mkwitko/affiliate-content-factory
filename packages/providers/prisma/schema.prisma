}

// Append-only metrics reading of one published post (lifetime counts at observedAt).
model ContentPerformance {
  id                         String    @id @default(uuid()) @db.Uuid
  workspaceId                String    @map("workspace_id") @db.Uuid
  contentVariantId           String    @map("content_variant_id")
  publicationAttemptId       String    @map("publication_attempt_id")
  observedAt                 DateTime  @map("observed_at")
  views                      Int?
  reach                      Int?
  likes                      Int?
  comments                   Int?
  shares                     Int?
  saves                      Int?
  profileVisits              Int?      @map("profile_visits")
  estimatedMinutesWatched    Int?      @map("estimated_minutes_watched")
  averageViewDurationSeconds Int?      @map("average_view_duration_seconds")
  averageViewPercentage      Decimal?  @map("average_view_percentage") @db.Decimal(6, 2)
  subscribersGained          Int?      @map("subscribers_gained")
  subscribersLost            Int?      @map("subscribers_lost")
  engagedViews               Int?      @map("engaged_views")
  platformUrl                String?   @map("platform_url")
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "content_performance_workspace_id_fkey")

  @@index([workspaceId, contentVariantId, observedAt], map: "content_performance_workspace_variant_observed_idx")
  @@index([publicationAttemptId], map: "content_performance_attempt_idx")
  @@map("content_performance")
}

/// Home machine credentials for the task API (ADR 0012): only a SHA-256 hash is stored; the
/// plain token is shown once. Scoped to one workspace and a list of capabilities; revocable.
model HomeWorkerToken {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  name         String
  tokenHash    String    @unique(map: "home_worker_tokens_token_hash_key") @map("token_hash")
  prefix       String
  capabilities String[]
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  heartbeat    Json?
  heartbeatAt  DateTime? @map("heartbeat_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "home_worker_tokens_workspace_id_fkey")

  @@index([workspaceId], map: "home_worker_tokens_workspace_id_idx")
  @@map("home_worker_tokens")
}
