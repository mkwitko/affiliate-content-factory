  acceptedBy   User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull, map: "invitations_accepted_by_id_fkey")

  @@index([workspaceId, email, status], map: "invitations_workspace_email_status_idx")
