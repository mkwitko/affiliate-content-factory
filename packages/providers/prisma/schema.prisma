// One tracked, attributable redirect to an offer's affiliate URL, usually one per content variant.
model TrackedLink {
  slug                   String    @id
  workspaceId            String    @map("workspace_id") @db.Uuid
  contentVariantId       String?   @map("content_variant_id")
  publicationAttemptId   String?   @map("publication_attempt_id")
  offerId                String?   @map("offer_id")
  marketplaceLabel       String?   @map("marketplace_label")
  destination            String
  destinationFingerprint String    @map("destination_fingerprint")
  fallbackUrl            String?   @map("fallback_url")
